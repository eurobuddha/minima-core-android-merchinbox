<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy (API < 31) Auto Backup rules.

   NOTHING in this app may leave the device. allowBackup="false" already disables this, but the excludes are
   explicit so the intent survives anyone flipping that flag back. What is at stake here:
   meta "vendoraddr" — locked on first write and deliberately never refreshed. Restored onto a node the
         user no longer owns, the vendor keeps publishing that address and BUYER PAYMENTS LAND IN A WALLET
         THEY CANNOT SPEND. Restored nftsent:/nftposted: flags also mark paid orders as already delivered
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
